--reset

--dt=bf16,bf16:bf16:f32,f32:bf16:f32,bf16:bf16:u8,bf16:bf16:s8
--bia_dt=undef,f32,bf16
--beta=0,1
--attr-post-ops=,sum:2,relu
--brgemm-attr=,use_uker:1
--batch=option_set_bf16

# Roll loop hints
# Both batch kinds cover the run-time bs walk; interleaved tile stores keep
# the bs loop unrolled, hence use_interleave_stores:0 for its hint.
--reset
--dt=bf16,bf16:bf16:f32
--bia_dt=undef,f32
--beta=0,1
--batch-kind=addr,offs
--brgemm-attr=use_uker:1+hint_roll_bd_loop:1,use_uker:1+hint_roll_ld_loop:1,use_uker:1+use_interleave_stores:0+hint_roll_bs_loop:1,use_uker:1+hint_roll_rd_loop:1
--batch=option_set_bf16

# Roll the bd and bs loops together
# A rolled bd loop keeps its A displacement across the A reloads of a batch;
# shapes have more than one bd block, otherwise the bd loop does not roll.
--reset
--dt=bf16,bf16:bf16:f32
--bia_dt=undef,f32
--beta=0,1
--bs=1,3
--batch-kind=addr,offs
--brgemm-attr=use_uker:1+use_interleave_stores:0+hint_roll_bd_loop:1+hint_roll_bs_loop:1,use_uker:1+use_interleave_stores:0+hint_roll_bd_loop:1+hint_roll_bs_loop:1+hint_roll_rd_loop:1
64x32:32x32 64x32:32x48 64x64:64x32 64x64:64x64 64x96:96x48 64x256:256x64 128x64:64x32 128x256:256x64
--bs=1
64x16:16x32

# Roll the ld loop over a multi element batch
# The ld loop sits outside the bs loop and keeps its B displacement in
# reg_ld_B_shift, because every batch element reloads B.
--reset
--dt=bf16,bf16:bf16:f32
--bia_dt=undef,f32
--beta=0,1
--bs=1,3
--batch-kind=addr,offs
--brgemm-attr=use_uker:1+use_interleave_stores:0+hint_roll_ld_loop:1,use_uker:1+use_interleave_stores:0+hint_roll_ld_loop:1+hint_roll_bs_loop:1
--batch=option_set_bf16

# Roll the bd loop with a runtime batch size
# The var_bs loop keeps its counter aside so that r9, which addresses the
# next bd iteration, survives the shared body.
--reset
--dt=bf16,bf16:bf16:f32
--bia_dt=undef,f32
--beta=0,1
--bs=1,3
--batch-kind=addr,offs
--brgemm-attr=use_uker:1+use_interleave_stores:0+var_bs:1+hint_roll_bd_loop:1,use_uker:1+use_interleave_stores:0+var_bs:1+hint_roll_bd_loop:1+hint_roll_rd_loop:1
64x32:32x32 64x32:32x48 64x64:64x32 64x64:64x64 64x96:96x48 64x256:256x64 128x64:64x32 128x256:256x64
--bs=1
64x16:16x32

# Roll loop hints on the bf32 down-conversion path
# The down-conversion slots are picked at JIT time, so the hints must be
# ignored here; this catches a regression in that gating.
--reset
--dt=f32
--attr-fpmath=bf16
--bia_dt=undef,f32
--beta=0,1
--bs=1,3
--batch-kind=addr,offs
--brgemm-attr=use_uker:1+hint_roll_bd_loop:1,use_uker:1+hint_roll_ld_loop:1,use_uker:1+use_interleave_stores:0+hint_roll_bs_loop:1,use_uker:1+hint_roll_rd_loop:1
--batch=option_set_bf16

# Separate cases for non-default alpha
--reset
--dt=bf16
--alpha=2
--batch=shapes_2d_no_tail_bf16

# Skip-acc feature
--reset
--brgemm-attr=generate_skip_accumulation:1,generate_skip_accumulation:1+use_uker:1
--beta=0,1
--bia_dt=f32
--dt=bf16
--batch=option_set_bf16

# ukernel wtag support
--reset
--wtag=ba
--dt=bf16
--batch=option_set_bf16

# aarch64 mmla coverage
--batch=harness_brgemm_mmla
