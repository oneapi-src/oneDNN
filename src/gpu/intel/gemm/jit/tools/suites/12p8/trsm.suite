trsmll SSS ABN 32 32 1 0
trsmlu SSS ABN 32 32 1 0
trsmrl SSS ABN 32 32 1 0
trsmru SSS ABN 32 32 1 0
trsmll DDD ABN 32 32 1 0
trsmlu DDD ABN 32 32 1 0
trsmrl DDD ABN 32 32 1 0
trsmru DDD ABN 32 32 1 0
trsmll CCC ABN 16 16 1 0
trsmlu CCC ABN 16 16 1 0
trsmrl CCC ABN 16 16 1 0
trsmru CCC ABN 16 16 1 0
trsmll ZZZ ABN 16 16 1 0
trsmlu ZZZ ABN 16 16 1 0
trsmrl ZZZ ABN 16 16 1 0
trsmru ZZZ ABN 16 16 1 0
# Read checks for C loads used in TRSMs
rc gemm SSS NTN 32 32 1 1 ab1 ab1 ab el np
rc gemm SSS NTN 32 32 1 1 ab1 ab1 as el np
rc gemm DDD NTN 32 32 1 1 ab1 ab1 as el np grf256
rc gemm DDD NTN 32 32 1 1 ab1 ab1 ab el np grf256
rc gemm CCC NTN 16 16 1 1 ab1 ab1 ab el np
rc gemm CCC NTN 16 16 1 1 ab1 ab1 as el np
rc gemm ZZZ NTN 16 16 1 1 ab1 ab1 ab el np grf256
rc gemm ZZZ NTN 16 16 1 1 ab1 ab1 as el np grf256
